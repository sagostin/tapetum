# Tapetum deployment settings. Copy to `.env` and edit — docker compose reads
# it automatically; you should never need to touch docker-compose.yml.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=tapetum
# Change this before exposing anything. Stick to letters/numbers — the
# password is interpolated into TAPETUM_DATABASE_URL without URL-encoding.
POSTGRES_PASSWORD=tapetum
POSTGRES_DB=tapetum

# --- App --------------------------------------------------------------------
# Plain-HTTP mode: drops the Secure cookie flag. REQUIRED for http:// access,
# including LAN IPs (http://192.168.x.x:8080). Set to false only when serving
# behind HTTPS (reverse proxy with TLS, or tailscale serve).
TAPETUM_DEV=true

# External URL used in notification/export links (only when behind a domain).
# TAPETUM_PUBLIC_URL=https://nvr.example.com

# 64 hex chars (`openssl rand -hex 32`). If unset, a key is generated once at
# /data/server.key — fine as long as the tapetum-data volume survives.
# TAPETUM_SECRET_KEY=

# TAPETUM_LOG_LEVEL=info

# Full database URL override. Only needed for exotic setups (external
# Postgres, or network_mode: host) — normally built from the POSTGRES_* vars.
# TAPETUM_DATABASE_URL=postgres://tapetum:tapetum@localhost:5432/tapetum?sslmode=disable

# --- Ports ------------------------------------------------------------------
# Host port for the web UI / API.
APP_PORT=8080

# Publishes Postgres on the host for local tooling (`make run`, psql).
# Localhost-only by default, which is safe to keep in production. To disable
# entirely, remove the ports block from the db service in docker-compose.yml.
DB_BIND=127.0.0.1:5432
